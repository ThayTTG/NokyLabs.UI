<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ícones de traço, desenhados numa grade de 24x24.
       Use com: <Viewbox Width="18" Height="18"><Path Classes="icon" Data="{StaticResource IconSearch}" /></Viewbox> -->

  <!-- O "n" do NokyLabs (o mesmo desenho do ícone do app) -->
  <StreamGeometry x:Key="IconLogo">M7.5,7 V17 M7.5,11.5 A4.5,4.5 0 0 1 16.5,11.5 V17</StreamGeometry>

  <!-- Navegação -->
