<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NokyLabs.UI.NokyTheme">

  <!-- O tema completo. No App.axaml de cada app:
         <Application.Styles>
           <FluentTheme />
           <ui:NokyTheme Accent="#6EE7B7" />
         </Application.Styles>
       Coloque depois do FluentTheme, para os estilos do Kit ganharem. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NokyLabs.UI/Tema/Cores.axaml" />
        <ResourceInclude Source="avares://NokyLabs.UI/Tema/Icones.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://NokyLabs.UI/Tema/Controles.axaml" />

</Styles>
